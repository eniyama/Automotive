#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <linux/input.h>
#include <errno.h>

#define DEVICE "/dev/input/event6"

/* ---------- Conversion helpers ---------- */
float steering_to_degree(int value)
{
    const float CENTER = 32767.0f;
    const float MAX_DEGREE = 450.0f;
    return ((value - CENTER) * MAX_DEGREE) / CENTER;
}

float pedal_to_percent(int value)
{
    const float MAX = 1023.0f;
    return (value * 100.0f) / MAX;
}


/* ---------- Gear mapping ---------- */
int gear_from_code(int code)
{
    switch (code) {
        case 300: return 1;
        case 301: return 2;
        case 302: return 3;
        case 303: return 4;
        case 704: return 5;
        case 305: return 6;
        case 705: return -1;  // Reverse
        default:  return 0;
    }
}

int main()
{
    struct input_event ev;
    int fd;
    int current_gear = 0;

    fd = open(DEVICE, O_RDONLY);
      if (fd < 0) {
        perror("Cannot open input device");
        return 1;
    }

    printf("=== Logitech G29 Input Monitor ===\n");
    printf("Steering (deg), Pedals (%%), Gears\n");
    printf("Press Ctrl+C to exit\n\n");

    while (1) {
        if (read(fd, &ev, sizeof(ev)) != sizeof(ev))
            continue;

        /* ---------- AXES (wheel + pedals) ---------- */
        if (ev.type == EV_ABS) {
            switch (ev.code) {
                case ABS_X:
                    printf("Steering: %7.1f deg\n",
                           steering_to_degree(ev.value));
                    break;

                case ABS_Z:
                    printf("Accelerator: %6.1f %%\n",
                           pedal_to_percent(ev.value));
                    break;

                case ABS_RZ:
                    printf("Brake:       %6.1f %%\n",
                           pedal_to_percent(ev.value));
                    break;

                case ABS_Y:
                    printf("Clutch:      %6.1f %%\n",
                           pedal_to_percent(ev.value));
                    break;
            }
        }

        /* ---------- GEARS ---------- */
        if (ev.type == EV_KEY) {

            /* Gear engaged */
            if (ev.value == 1) {
                            int gear = gear_from_code(ev.code);

                if (gear != 0) {
                    current_gear = gear;

                    if (gear == -1)
                        printf("Gear: REVERSE\n");
                    else
                        printf("Gear: %d\n", gear);
                }
            }

            /* Gear released → Neutral */
            if (ev.value == 0) {
                int gear = gear_from_code(ev.code);
                if (gear != 0) {
                    current_gear = 0;
                    printf("Gear: NEUTRAL\n");
                }
            }
        }
        if (ev.type == EV_ABS) {
        if (ev.code == ABS_HAT0X) {
        if (ev.value == -1) printf("D-pad LEFT\n");
        else if (ev.value == 1) printf("D-pad RIGHT\n");
        }

        if (ev.code == ABS_HAT0Y) {
        if (ev.value == -1) printf("D-pad UP\n");
        else if (ev.value == 1) printf("D-pad DOWN\n");
       }
       }

    }

    close(fd);
    return 0;
}
